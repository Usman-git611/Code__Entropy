# MySQL: create this database once: CREATE DATABASE learndna CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/learndna
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
# Set to openai or gemini only after supplying its key. Default demo mode is transparent and deterministic.
AI_PROVIDER=demo
# For real Iqra AI: set AI_PROVIDER=openai, paste a server-side API key, then restart.
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-5
# No-key local AI option (install Ollama, then pull this model).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
LOCAL_COMPILER_ENABLED=false
